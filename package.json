{
  "name": "assay-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Assay - Financial Health Copilot (Frontend & Backend)",
  "scripts": {
    "start": "npm --prefix frontend start",
    "dev:frontend": "npm --prefix frontend start",
    "dev:backend": "cd backend && (../.venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 || uvicorn app.main:app --reload --host 0.0.0.0 --port 8000)",
    "ios": "npm --prefix frontend run ios",
    "android": "npm --prefix frontend run android",
    "web": "npm --prefix frontend run web"
  },
  "dependencies": {
    "expo": "^57.0.27"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
