PROJECT_NAME="Assay API"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT="development"
CORS_ORIGINS=["*"]

# Database (SQLite locally; use the Supabase direct connection string in deployment)
# DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
DATABASE_URL="sqlite:///./assay.db"
# Leave unset locally. Set false when using the teammate-managed Supabase schema.
# MANAGE_SCHEMA=false

# LLM Provider Configuration
LLM_PROVIDER="mock" # "mock" | "openai" | "anthropic" | "gemini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Account Aggregator Provider
AA_PROVIDER="mock" # "mock" | "setu" | "finvu" | "onemoney"
AA_CLIENT_ID=""
AA_CLIENT_SECRET=""
