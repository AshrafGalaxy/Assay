PROJECT_NAME="Assay API"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT="development"
CORS_ORIGINS=["*"]

# Database (SQLite locally; use the Supabase direct connection string in deployment)
# DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
DATABASE_URL="sqlite:///./assay.db"
# Leave unset locally. Set false when using the teammate-managed Supabase schema.
# MANAGE_SCHEMA=false

# LLM Provider Configuration
LLM_PROVIDER="mock" # "mock" | "openai" | "anthropic" | "gemini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Account Aggregator Provider
AA_PROVIDER="mock" # "mock" | "setu" | "finvu" | "onemoney"
AA_CLIENT_ID=""
AA_CLIENT_SECRET=""

# Synthetic personal-finance dataset (OFF by default — clean slate)
# Set SYNTHETIC_LEDGER_ENABLED=true and generate CSVs only for demos / ML eval.
# python -m app.services.financial_intelligence.synthetic_finance_generator
SYNTHETIC_LEDGER_ENABLED=false
SYNTHETIC_DATA_DIR="data/synthetic_finance"
SYNTHETIC_USER_ID=""          # empty = auto-pick a stable_income user
SYNTHETIC_SEED=42
SYNTHETIC_BOOTSTRAP_USERS=0   # >0 auto-generates only when enabled and CSVs missing
SYNTHETIC_START_MONTH="2023-01"
SYNTHETIC_HISTORICAL_MONTHS=12
SYNTHETIC_FORECAST_HORIZON=6

# Forecast provider seam for cash-flow / what-if projections
# run_rate = deterministic ledger run-rates (default)
# ml = load FORECAST_MODEL_PATH via MlForecastProvider (falls back if missing)
FORECAST_PROVIDER="run_rate"
FORECAST_MODEL_PATH=""
