# Copy to frontend/.env and adjust for your machine.
# Expo only loads files named .env / .env.local / etc. (not _env).

# Supabase (optional for local API-only work)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Backend API base URL (include /api/v1).
# Leave unset to auto-detect the Expo/Metro LAN host on device, or use:
#   iOS Simulator / Web:  http://localhost:8000/api/v1
#   Android Emulator:     http://10.0.2.2:8000/api/v1
#   Physical device:      http://YOUR_LAN_IP:8000/api/v1
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1
# EXPO_PUBLIC_API_URL=
